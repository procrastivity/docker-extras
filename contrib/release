#!/usr/bin/env bash
# contrib/release — cut a release. Runs the local twin of the CI gate,
# writes the git-cliff release notes into the annotated tag message, and
# pushes. The tag workflow (.github/workflows/release.yml) re-runs the
# gate, builds the assets (stamping the plugin VERSION at dist time), and
# creates the GitHub Release with the tag message as its body
# (--notes-from-tag).
#
# The notes travel in the tag, not in a committed CHANGELOG.md, on
# purpose (ste9/toolsmith C6.3: nothing in the repo can disagree with
# the tag it was built from). The tag sits on an ordinary commit; this
# script creates no commit of its own.
set -Eeuo pipefail

DIR=$(cd "$(dirname "${0}")" && pwd)
PROJECT_ROOT=$(cd "$DIR/.." && pwd)
cd "$PROJECT_ROOT"

usage() {
	echo "Usage: contrib/release --major | --minor | --patch | vX.Y.Z"
	echo
	echo "Runs make check, generates the release notes with git-cliff, tags"
	echo "the current commit with the notes as the annotated tag message,"
	echo "and pushes the branch and the tag (CI publishes the release from"
	echo "the tag message)."
	exit 1
}

# Convert the origin remote URL to its https web base, e.g.
#   git@host:owner/repo.git            -> https://host/owner/repo
#   ssh://git@host:2222/owner/repo.git -> https://host/owner/repo
#   https://host/owner/repo.git        -> https://host/owner/repo
remote_web_url() {
	local url
	url=$(git remote get-url origin)
	url="${url%.git}"
	if [[ "$url" =~ ^git@([^:]+):(.+)$ ]]; then
		url="https://${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
	elif [[ "$url" =~ ^ssh://(git@)?([^/:]+)(:[0-9]+)?/(.+)$ ]]; then
		url="https://${BASH_REMATCH[2]}/${BASH_REMATCH[4]}"
	fi
	printf '%s' "$url"
}

# --- Parse arguments ---

BUMP=""
EXPLICIT_TAG=""
case "${1:-}" in
--major | --minor | --patch) BUMP="${1#--}" ;;
v[0-9]*)
	# Must match cliff.toml's tag_pattern, or the tag would be invisible
	# to the changelog.
	[[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || usage
	EXPLICIT_TAG="$1"
	;;
*) usage ;;
esac

# --- Preconditions ---

for tool in git git-cliff gh shellcheck; do
	command -v "$tool" >/dev/null || {
		echo "error: '$tool' not found on PATH" >&2
		exit 1
	}
done

# Refuse to release from a dirty tree: the tag must name exactly the
# tree that passed the gate below. Untracked files are ignored.
if ! git diff --quiet || ! git diff --cached --quiet; then
	echo "error: working tree has uncommitted changes; commit or stash them first." >&2
	git status --short
	exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "main" ]]; then
	echo "warning: releasing from branch '$BRANCH', not 'main'" >&2
fi

WEB_URL=$(remote_web_url) # resolved before any mutation so a bad remote fails early

# --- Compute the new tag from the latest release tag ---

# Empty when no release tag exists yet: a real v0.0.0 is a valid tag, so
# it cannot double as the "no tags" sentinel.
CURRENT=$(git describe --tags --match 'v[0-9]*' --abbrev=0 2>/dev/null || echo "")
if [[ -n "$EXPLICIT_TAG" ]]; then
	TAG="$EXPLICIT_TAG"
else
	IFS=. read -r MAJOR MINOR PATCH <<<"${CURRENT#v}"
	: "${MAJOR:=0}" "${MINOR:=0}" "${PATCH:=0}"
	case "$BUMP" in
	major) TAG="v$((MAJOR + 1)).0.0" ;;
	minor) TAG="v${MAJOR}.$((MINOR + 1)).0" ;;
	patch) TAG="v${MAJOR}.${MINOR}.$((PATCH + 1))" ;;
	esac
fi

if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
	echo "error: tag $TAG already exists" >&2
	exit 1
fi

if [[ -n "$CURRENT" ]] && [[ "$(git rev-list "$CURRENT"..HEAD --count)" -eq 0 ]]; then
	echo "error: no commits since $CURRENT; nothing to release." >&2
	exit 1
fi

echo "Releasing ${CURRENT:-(no previous tag)} -> ${TAG} on branch ${BRANCH}"

# --- Gate: the local twin of what CI verifies on the tag workflow ---
# (make test self-skips without a docker daemon; the tag workflow runs it
# on a runner that has one, with REQUIRE_DOCKER=1.)

make check

# --- Generate the release notes (they become the tag message) ---

echo "Generating release notes for ${TAG}..."
make release-notes TAG="$TAG"
if ! [[ -s dist/RELEASE_NOTES.md ]]; then
	echo "error: dist/RELEASE_NOTES.md is empty; git-cliff produced no notes." >&2
	exit 1
fi

# --- Tag and push ---
#
# --cleanup=whitespace is load-bearing: the default (strip) deletes every
# line that starts with '#', and git-cliff notes start with '## [x.y.z]'.
git tag -a --cleanup=whitespace -F dist/RELEASE_NOTES.md "$TAG"

# Branch first, then the tag: the branch push runs a normal CI pass for
# any unpushed commits, and the tag push starts the release workflow on a
# commit the remote already has.
echo "Pushing ${BRANCH}, then ${TAG}..."
git push origin "$BRANCH"
git push origin "$TAG"

cat <<EOF

Pushed ${TAG}. CI will re-verify, build the release assets (the plugin
VERSION is stamped at dist time from the tag), and create the GitHub
Release with the tag message as its body.

Watch the workflow:
  gh run watch
Once released:
  ${WEB_URL}/releases
  curl -fsSL ${WEB_URL}/releases/latest/download/docker-extras-install.sh | sh
EOF
